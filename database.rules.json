{
  "rules": {
    "scores": {
      "all": {
        ".read": true,
        ".indexOn": [
          "score",
          "ts"
        ],
        "$id": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['name', 'score', 'won', 'turns', 'natives', 'ts'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000 && newData.val() <= 5000 / newData.parent().child('turns').val() + 37 * newData.parent().child('natives').val() + 1"
          },
          "won": {
            ".validate": "newData.val() === true"
          },
          "turns": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 500"
          },
          "natives": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 72"
          },
          "session": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{3,12}$/)"
          },
          "ts": {
            ".validate": "newData.val() == now"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "sessions": {
        "$session": {
          ".read": "$session.matches(/^[A-Z0-9]{3,12}$/)",
          ".indexOn": [
            "score",
            "ts"
          ],
          "$id": {
            ".write": "!data.exists() && $session.matches(/^[A-Z0-9]{3,12}$/)",
            ".validate": "newData.hasChildren(['name', 'score', 'won', 'turns', 'natives', 'ts'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000 && newData.val() <= 5000 / newData.parent().child('turns').val() + 37 * newData.parent().child('natives').val() + 1"
            },
            "won": {
              ".validate": "newData.val() === true"
            },
            "turns": {
              ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 500"
            },
            "natives": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 72"
            },
            "session": {
              ".validate": "newData.isString() && newData.val() == $session"
            },
            "ts": {
              ".validate": "newData.val() == now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "logs": {
      ".read": false,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['v', 'day', 'seed', 'outcome', 'turns', 'natives', 'invaders'])",
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "day": {
          ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-[01][0-9]-[0-3][0-9]$/)"
        },
        "seed": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
        },
        "outcome": {
          ".validate": "newData.val() === 'win' || newData.val() === 'loss' || newData.val() === 'abandoned'"
        },
        "turns": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500"
        },
        "natives": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 72"
        },
        "invaders": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 72"
        },
        "final": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4000"
        },
        "moves": {
          ".validate": "newData.hasChildren()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
